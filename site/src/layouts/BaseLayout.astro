---
// Base document layout: head, SEO meta, fonts, design tokens. Wraps every page.
import '../styles/tokens.css';
import '../styles/site.css';
import '../styles/mobile.css';
import { WHATSAPP_URL } from '../data/contact';
import ScrollTopButton from '../components/ScrollTopButton.astro';

interface Props {
  title: string;
  description: string;
  /** og/twitter image, relative to site root */
  image?: string;
}
const { title, description, image = '/assets/logo-tome-paiva-full-gold-on-black.jpeg' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  name: 'Tomé & Paiva Advogados Associados',
  url: Astro.site?.href,
  image: ogImage,
  telephone: '+55-19-3324-3864',
  email: 'contato@tomepaivaadvogados.com.br',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Rua Dona Ana Eufrosina, nº 54, Sala 1 — Jardim Brasil',
    addressLocality: 'Campinas',
    addressRegion: 'SP',
    postalCode: '13073-023',
    addressCountry: 'BR',
  },
  areaServed: 'BR',
  knowsAbout: [
    'Direito do Trabalho',
    'Direito Previdenciário',
    'Famílias e Sucessões',
    'Direito Civil',
    'Direito do Consumidor',
  ],
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#111111" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/assets/favlogo.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tomé & Paiva Advogados Associados" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
    <ScrollTopButton />
    <a
      href={WHATSAPP_URL}
      class="tp-whatsapp-fab"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Falar pelo WhatsApp"
    >
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>

    <script>
      // Click an e-mail link (any `mailto:` — Contact, Footer, anywhere) to copy
      // the address to the clipboard and show a brief "E-mail copiado" toast near
      // the cursor, instead of opening the mail client.
      const CHECK_SVG =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';

      function emailFromLink(link: HTMLAnchorElement): string {
        const href = link.getAttribute('href') || '';
        // drop the "mailto:" scheme and any ?subject=/&body= params
        return decodeURIComponent(href.replace(/^mailto:/i, '').split('?')[0]).trim();
      }

      async function copyText(text: string): Promise<boolean> {
        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(text);
            return true;
          }
        } catch (_) { /* fall through to legacy path */ }
        try {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.top = '-1000px';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          const ok = document.execCommand('copy');
          document.body.removeChild(ta);
          return ok;
        } catch (_) {
          return false;
        }
      }

      let toast: HTMLDivElement | null = null;
      let hideTimer = 0;

      function showToast(x: number, y: number, label: string) {
        if (!toast) {
          toast = document.createElement('div');
          toast.className = 'tp-copy-toast';
          toast.setAttribute('role', 'status');
          toast.setAttribute('aria-live', 'polite');
          document.body.appendChild(toast);
        }
        const span = document.createElement('span');
        span.textContent = label;
        toast.innerHTML = CHECK_SVG;
        toast.appendChild(span);
        // flip below the cursor if there isn't room above (near the top edge)
        toast.classList.toggle('tp-copy-toast--below', y < 64);
        toast.style.left = `${x}px`;
        toast.style.top = `${y}px`;
        void toast.offsetWidth; // reflow so the opacity transition replays
        toast.classList.add('is-visible');
        clearTimeout(hideTimer);
        hideTimer = window.setTimeout(() => toast?.classList.remove('is-visible'), 1500);
      }

      document.addEventListener('click', async (e) => {
        const target = e.target as HTMLElement | null;
        const link = target?.closest('a[href^="mailto:" i]') as HTMLAnchorElement | null;
        if (!link) return;
        e.preventDefault();

        const email = emailFromLink(link);
        const ok = await copyText(email);

        // anchor the toast to the pointer; fall back to the link for keyboard activation
        let x = e.clientX;
        let y = e.clientY;
        if (!x && !y) {
          const r = link.getBoundingClientRect();
          x = r.left + r.width / 2;
          y = r.top;
        }
        showToast(x, y, ok ? 'E-mail copiado' : email);
      });
    </script>
  </body>
</html>
