---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import BlogBackFab from '../../components/BlogBackFab.astro';
import { getCollection, render } from 'astro:content';
import '../../styles/blog.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, author, cover, tags } = post.data;
const dateStr = pubDate.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
const meta = [tags[0], dateStr, author].filter(Boolean).join(' · ');
---
<BaseLayout title={`${title} · Tomé & Paiva`} description={description} image={cover}>
  <Navbar active="blog" />

  <article class="tp-article">
    <div class="tp-container">
      <nav class="tp-crumb" aria-label="breadcrumb">
        <a href="/">Início</a>
        <span>·</span>
        <a href="/blog">Blog</a>
        <span>·</span>
        <span class="tp-current">{title}</span>
      </nav>

      <header class="tp-article__head">
        <div class="tp-article__meta">{meta}</div>
        <h1 class="tp-article__title">{title}</h1>
        <p class="tp-article__lede">{description}</p>
      </header>

      {cover && <img src={cover} alt="" class="tp-article__cover" />}

      <div class="tp-prose tp-article__body">
        <Content />
      </div>
    </div>
  </article>

  <Footer />
  <BlogBackFab />
</BaseLayout>
