---
import { SPECIALTIES } from '../data/specialties';
import { WHATSAPP_URL, MAPS_DIRECTIONS_URL } from '../data/contact';
const year = new Date().getFullYear();
---
<footer class="tp-footer">
  <div class="tp-container">
    <div class="tp-footer__grid">
      <div class="tp-footer__brand">
        <img src="/assets/logo-tome-paiva-gold.png" alt="Tomé e Paiva" />
        <p>
          Tomé &amp; Paiva, advogados associados.
          Campinas / SP. Atuação com abrangência nacional.
        </p>
      </div>
      <div class="tp-footer__col">
        <h5>Navegação</h5>
        <ul>
          <li><a href="/#escritorio">Escritório</a></li>
          <li><a href="/especialidades">Especialidades</a></li>
          <li><a href="/#equipe">Equipe</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/#contato">Contato</a></li>
        </ul>
      </div>
      <div class="tp-footer__col">
        <h5>Áreas</h5>
        <ul>
          {SPECIALTIES.map((s) => (
            <li><a href={`/especialidades#${s.id}`}>{s.title}</a></li>
          ))}
        </ul>
      </div>
      <div class="tp-footer__col">
        <h5>Contato</h5>
        <ul>
          <li><a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer">(19) 3324-3864</a></li>
          <li><button class="tp-copy-btn" data-copy="@tomepaivaadvogados">@tomepaivaadvogados</button></li>
          <li><a href="mailto:contato@tomepaivaadvogados.com.br">contato@tomepaivaadvogados.com.br</a></li>
          <li><a href={MAPS_DIRECTIONS_URL} target="_blank" rel="noopener noreferrer">Endereço · Como chegar</a></li>
        </ul>
      </div>
    </div>
    <div class="tp-footer__bottom">
      <div>© {year} TOMÉ &amp; PAIVA ADVOGADOS ASSOCIADOS</div>
      <div>OAB/SP 35712 · CAMPINAS/SP</div>
    </div>
    <div class="tp-footer__credit">
      Site desenvolvido por
      <a href="https://almeidaescaladigital.com/" target="_blank" rel="noopener noreferrer">Almeida Escala Digital</a>
    </div>
  </div>
</footer>

<style>
.tp-copy-btn {
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
  font-weight: 400;
  font-size: 14px;
  font-family: inherit;
  color: var(--on-surface-variant);
  transition: color var(--dur-fast);
  text-align: left;
}
.tp-copy-btn:hover { color: var(--primary); }
</style>

<script>
document.querySelectorAll<HTMLButtonElement>('.tp-copy-btn').forEach((btn) => {
  const label = btn.textContent ?? '';
  btn.addEventListener('click', () => {
    navigator.clipboard.writeText(btn.dataset.copy ?? '');
    btn.textContent = 'texto copiado';
    setTimeout(() => { btn.textContent = label; }, 1500);
  });
});
</script>
