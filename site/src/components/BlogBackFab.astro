---
// Floating button that follows the scroll and returns the reader to the blog
// section ("Últimos artigos") on the landing page. Fades in after scrolling down.
---
<a class="tp-blog-fab" href="/#blog" aria-label="Voltar à seção de blog na página inicial">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M19 12H5M12 19l-7-7 7-7" />
  </svg>
  <span>Blog</span>
</a>

<style>
  .tp-blog-fab {
    position: fixed;
    right: 20px;
    bottom: max(20px, env(safe-area-inset-bottom, 0px));
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 12px 18px;
    background: rgba(11, 11, 11, 0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-2);
    color: var(--primary);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    box-shadow: var(--shadow-float);
    opacity: 0;
    transform: translateY(14px);
    pointer-events: none;
    transition: opacity var(--dur-base) var(--ease-standard),
                transform var(--dur-base) var(--ease-standard),
                border-color var(--dur-base) var(--ease-standard),
                background var(--dur-base) var(--ease-standard);
  }
  .tp-blog-fab.is-visible {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .tp-blog-fab:hover {
    border-color: var(--primary);
    background: rgba(11, 11, 11, 0.9);
  }
  .tp-blog-fab svg { width: 16px; height: 16px; }
  /* On phones the "back to blog" button lives on the LEFT (better thumb reach). */
  @media (max-width: 640px) {
    .tp-blog-fab {
      right: auto;
      left: max(16px, env(safe-area-inset-left, 0px));
      padding: 11px 15px;
      font-size: 11px;
    }
  }
</style>

<script>
  const fab = document.querySelector('.tp-blog-fab');
  if (fab) {
    const onScroll = () => fab.classList.toggle('is-visible', window.scrollY > 400);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
