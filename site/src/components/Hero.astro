---
// Hero — gradient backdrop + a parallax brand symbol that drifts toward the cursor,
// a cursor-tracked spotlight that lights ONLY the logo artwork (mask × the PNG alpha),
// and floating golden dust. Effects run client-side and rest gracefully on touch and
// when prefers-reduced-motion is set. The text content is local — do not change it.
import Button from './Button.astro';
import { WHATSAPP_URL } from '../data/contact';
---
<section id="hero" class="tp-hero">
  <div class="tp-hero__bg"></div>
  <div class="tp-hero__logo" aria-hidden="true">
    <img class="tp-hero__logo-layer tp-hero__logo-base" src="/assets/logo-tome-paiva-gold.png" alt="" draggable="false" />
    <img class="tp-hero__logo-layer tp-hero__logo-lit" src="/assets/logo-tome-paiva-gold.png" alt="" draggable="false" />
  </div>
  <canvas class="tp-hero__particles" aria-hidden="true"></canvas>

  <div class="tp-hero__layout">
    <div class="tp-hero__top">
      <div class="tp-hero__eyebrow">
        <span>Campinas / SP</span>
      </div>
      <h1>A <em>segurança</em> jurídica que você precisa<br />para exigir os seus direitos</h1>
    </div>
    <div class="tp-hero__bottom">
      <p>
        A Tomé &amp; Paiva Advogados Associados atua em demandas
        estratégicas, contenciosas e consultivas. Possuímos equipes
        dedicadas por área de atuação, com acompanhamento próximo ao cliente.
      </p>
      <div class="tp-hero__cta-row">
        <Button variant="primary" href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" iconRight>Fale conosco</Button>
        <Button variant="secondary" href="/especialidades">Conhecer especialidades</Button>
      </div>
    </div>
  </div>
</section>

<script>
  const hero = document.querySelector('.tp-hero') as HTMLElement | null;
  if (hero) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Both animation loops expose start/stop so an IntersectionObserver can pause
    // them while the hero is scrolled out of view (the loops otherwise run forever).
    let startParallax = () => {};
    let stopParallax = () => {};
    let startParticles = () => {};
    let stopParticles = () => {};

    // ---------- Parallax symbol + spotlight (anti-flick, exponential easing) ----------
    const wrap = hero.querySelector('.tp-hero__logo') as HTMLElement | null;
    if (wrap && !reduceMotion) {
      let raf = 0;
      const P = { parallax: 6, lag: 1, spotIntensity: 0.6 };
      const s = {
        rawNx: 0, rawNy: 0, smNx: 0, smNy: 0, px: 0, py: 0,
        rawCx: -9999, rawCy: -9999, smCx: -9999, smCy: -9999,
        mx: -9999, my: -9999, active: false, last: 0,
      };
      let rect = wrap.getBoundingClientRect();
      const measure = () => { rect = wrap.getBoundingClientRect(); };

      function onMove(e: MouseEvent) {
        const hr = hero!.getBoundingClientRect();
        const nx = Math.max(-1, Math.min(1, (e.clientX - (hr.left + hr.width / 2)) / (hr.width / 2)));
        const ny = Math.max(-1, Math.min(1, (e.clientY - (hr.top + hr.height / 2)) / (hr.height / 2)));
        s.rawNx = nx; s.rawNy = ny; s.rawCx = e.clientX; s.rawCy = e.clientY;
        if (!s.active) { s.smCx = e.clientX; s.smCy = e.clientY; }
        s.active = true;
      }
      const ease = (cur: number, target: number, tau: number, dt: number) =>
        cur + (target - cur) * (1 - Math.exp(-dt / tau));

      function tick(now: number) {
        const dt = s.last ? Math.min((now - s.last) / 1000, 0.05) : 0.016; s.last = now;
        const inputTau = 0.10 + P.lag * 0.22;   // de-jitter of the raw pointer
        const moveTau = 0.22 + P.lag * 0.85;    // the slow, heavy drift
        s.smNx = ease(s.smNx, s.rawNx, inputTau, dt);
        s.smNy = ease(s.smNy, s.rawNy, inputTau, dt);
        s.px = ease(s.px, -s.smNx * P.parallax, moveTau, dt);
        s.py = ease(s.py, -s.smNy * P.parallax * 0.7, moveTau, dt);
        s.smCx = ease(s.smCx, s.rawCx, inputTau, dt);
        s.smCy = ease(s.smCy, s.rawCy, inputTau, dt);
        s.mx = s.smCx - (rect.left + s.px);
        s.my = s.smCy - (rect.top + s.py);
        wrap!.style.setProperty('--px', s.px.toFixed(2) + 'px');
        wrap!.style.setProperty('--py', s.py.toFixed(2) + 'px');
        wrap!.style.setProperty('--mx', s.mx.toFixed(1) + 'px');
        wrap!.style.setProperty('--my', s.my.toFixed(1) + 'px');
        wrap!.style.setProperty('--spot-op', (s.active ? P.spotIntensity : 0).toFixed(2));
        raf = requestAnimationFrame(tick);
      }

      window.addEventListener('mousemove', onMove);
      hero.addEventListener('mouseleave', () => { s.active = false; });
      window.addEventListener('resize', measure);
      window.addEventListener('scroll', measure, { passive: true });

      startParallax = () => { if (!raf) { s.last = 0; raf = requestAnimationFrame(tick); } };
      stopParallax = () => { if (raf) { cancelAnimationFrame(raf); raf = 0; } };
    }

    // ---------- Floating golden dust ----------
    type Particle = { x: number; y: number; vx: number; vy: number; r: number; a: number; tw: number; tws: number };
    const canvas = hero.querySelector('.tp-hero__particles') as HTMLCanvasElement | null;
    const ctx = canvas ? canvas.getContext('2d') : null;
    if (canvas && ctx && !reduceMotion) {
      let raf = 0;
      const HEADER = 76, COUNT = 46;
      let w = 0, h = 0;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      let parts: Particle[] = [];
      let lastP = 0;

      function resize() {
        const r = canvas!.getBoundingClientRect(); w = r.width; h = r.height;
        canvas!.width = Math.round(w * dpr); canvas!.height = Math.round(h * dpr);
        ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      function seed() {
        parts = Array.from({ length: COUNT }, () => {
          const ang = Math.random() * Math.PI * 2, spd = 4 + Math.random() * 9;
          return {
            x: Math.random() * w, y: HEADER + Math.random() * (h - HEADER),
            vx: Math.cos(ang) * spd, vy: Math.sin(ang) * spd,
            r: 0.6 + Math.random() * 1.4, a: 0.18 + Math.random() * 0.4,
            tw: Math.random() * Math.PI * 2, tws: 0.4 + Math.random() * 0.8,
          };
        });
      }
      function tickP(now: number) {
        const dt = lastP ? Math.min((now - lastP) / 1000, 0.05) : 0.016; lastP = now;
        ctx!.clearRect(0, 0, w, h);
        for (const p of parts) {
          p.x += p.vx * dt; p.y += p.vy * dt;
          if (p.x < p.r) { p.x = p.r; p.vx = Math.abs(p.vx); }
          if (p.x > w - p.r) { p.x = w - p.r; p.vx = -Math.abs(p.vx); }
          if (p.y < HEADER + p.r) { p.y = HEADER + p.r; p.vy = Math.abs(p.vy); }
          if (p.y > h - p.r) { p.y = h - p.r; p.vy = -Math.abs(p.vy); }
          p.tw += p.tws * dt;
          const a = p.a * (0.65 + 0.35 * Math.sin(p.tw));
          ctx!.beginPath(); ctx!.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx!.fillStyle = 'rgba(207,168,96,' + a.toFixed(3) + ')'; ctx!.fill();
        }
        raf = requestAnimationFrame(tickP);
      }

      resize(); seed();
      window.addEventListener('resize', () => {
        const rel = parts.map((p) => [p.x / w, (p.y - HEADER) / (h - HEADER)]);
        resize();
        parts.forEach((p, i) => { p.x = rel[i][0] * w; p.y = HEADER + rel[i][1] * (h - HEADER); });
      });

      startParticles = () => { if (!raf) { lastP = 0; raf = requestAnimationFrame(tickP); } };
      stopParticles = () => { if (raf) { cancelAnimationFrame(raf); raf = 0; } };
    }

    // ---------- Run only while the hero is on screen ----------
    if (!reduceMotion) {
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) { startParallax(); startParticles(); }
            else { stopParallax(); stopParticles(); }
          }
        }, { threshold: 0 });
        io.observe(hero);
      } else {
        startParallax(); startParticles();
      }
    }
  }
</script>
