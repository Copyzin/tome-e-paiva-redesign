---
// Fixed top nav: transparent on top, blurred-dark glass on scroll. Mobile sheet menu
// with staggered entry, an Especialidades accordion, scroll-lock + position restore,
// and a WhatsApp CTA. Especialidades dropdown on desktop is pure CSS (:hover).
import { SPECIALTIES } from '../data/specialties';
import { WHATSAPP_URL } from '../data/contact';
interface Props { active?: string; }
const { active = 'home' } = Astro.props;
const isActive = (key: string) => (active === key ? 'is-active' : '');
---
<header class="tp-nav" id="tp-nav">
  <div class="tp-nav__inner">
    <a href="/" class="tp-nav__brand">
      <span class="tp-logo" aria-label="Tomé e Paiva — Advogados Associados">
        <img class="tp-logo__mark" src="/assets/logo-tome-paiva-gold.png" alt="" />
        <span class="tp-logo__words">
          <span class="tp-logo__name">
            <span>TOMÉ</span><span class="tp-logo__amp">&amp;</span><span>PAIVA</span>
          </span>
          <span class="tp-logo__sub" aria-hidden="true">
            <span>a</span><span>d</span><span>v</span><span>o</span><span>g</span><span>a</span><span>d</span><span>o</span><span>s</span>
            <span class="tp-logo__sub-gap"></span>
            <span>a</span><span>s</span><span>s</span><span>o</span><span>c</span><span>i</span><span>a</span><span>d</span><span>o</span><span>s</span>
          </span>
        </span>
      </span>
    </a>
    <span class="tp-nav__divider" aria-hidden="true"></span>
    <nav class="tp-nav__links">
      <a href="/#escritorio" class:list={['tp-nav__link', isActive('escritorio')]}>Escritório</a>

      <div class="tp-nav__dropdown-wrap">
        <a href="/especialidades" class:list={['tp-nav__link', isActive('especialidades')]} aria-haspopup="true">
          Especialidades
          <svg class="tp-nav__link-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
        </a>
        <div class="tp-nav__dropdown" role="menu">
          {SPECIALTIES.map((s) => (
            <a href={`/especialidades#${s.id}`} role="menuitem">
              <span>{s.title}</span>
              <span class="tp-nav__dropdown-num">{s.num}</span>
            </a>
          ))}
        </div>
      </div>

      <a href="/#equipe" class:list={['tp-nav__link', isActive('equipe')]}>Equipe</a>
      <a href="/blog" class:list={['tp-nav__link', isActive('blog')]}>Blog</a>
      <a href="/#contato" class:list={['tp-nav__link', isActive('contato')]}>Contato</a>
    </nav>
    <a href="/#contato" class="tp-nav__cta">Fale conosco</a>
    <button class="tp-nav__mobile-toggle" id="tp-nav-toggle" aria-label="Menu" aria-expanded="false">
      <svg class="tp-nav__icon-open" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      <svg class="tp-nav__icon-close" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </div>
</header>

<div class="tp-mobile-menu" id="tp-mobile-menu">
  <a href="/#escritorio" class:list={['tp-mm-item', isActive('escritorio')]} style="--i: 1">Escritório</a>

  <div class="tp-mm-group" style="--i: 2">
    <button type="button" class="tp-mm-item tp-mm-toggle" id="tp-mm-espec" aria-expanded="false" aria-controls="tp-mm-sub">
      <span>Especialidades</span>
      <svg class="tp-mm-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
    </button>
    <div class="tp-mm-sub" id="tp-mm-sub">
      <div class="tp-mm-sub__inner">
        {SPECIALTIES.map((s, i) => (
          <a href={`/especialidades#${s.id}`} class="tp-mm-subitem" style={`--j: ${i}`}>
            <span class="tp-mm-subitem__num">{s.num}</span>
            <span>{s.title}</span>
          </a>
        ))}
      </div>
    </div>
  </div>

  <a href="/#equipe" class:list={['tp-mm-item', isActive('equipe')]} style="--i: 3">Equipe</a>
  <a href="/blog" class:list={['tp-mm-item', isActive('blog')]} style="--i: 4">Blog</a>
  <a href="/#contato" class:list={['tp-mm-item', isActive('contato')]} style="--i: 5">Contato</a>

  <a href={WHATSAPP_URL} class="tp-mobile-menu__cta" target="_blank" rel="noopener noreferrer" style="--i: 6">Falar pelo WhatsApp</a>
</div>

<style>
  /* mobile toggle icon swap (hamburger ↔ X) */
  .tp-nav__mobile-toggle .tp-nav__icon-close { display: none; }
  .tp-nav__mobile-toggle[aria-expanded='true'] .tp-nav__icon-open { display: none; }
  .tp-nav__mobile-toggle[aria-expanded='true'] .tp-nav__icon-close { display: inline-flex; }

  /* scrollable overlay (body is locked while open) */
  #tp-mobile-menu { overflow-y: auto; -webkit-overflow-scrolling: touch; }

  /* top-level items: links + the Especialidades accordion toggle */
  #tp-mobile-menu .tp-mm-item {
    display: flex; align-items: center; justify-content: space-between;
    width: 100%;
    font-family: var(--font-sans);
    font-weight: 300; font-size: 28px; line-height: 1; letter-spacing: -0.01em;
    color: var(--on-surface);
    padding: 22px 0;
    background: transparent;
    border: none; border-bottom: 1px solid var(--hairline);
    text-align: left; cursor: pointer;
  }
  #tp-mobile-menu .tp-mm-item.is-active { color: var(--primary); }
  #tp-mobile-menu .tp-mm-group { display: flex; flex-direction: column; }
  #tp-mobile-menu .tp-mm-chev {
    width: 18px; height: 18px; color: var(--primary); flex-shrink: 0;
    transition: transform 300ms var(--ease-standard);
  }
  #tp-mobile-menu .tp-mm-toggle[aria-expanded='true'] .tp-mm-chev { transform: rotate(180deg); }

  /* Especialidades accordion — fluid grid-rows expand + staggered subitem reveal */
  #tp-mobile-menu .tp-mm-sub {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 380ms var(--ease-emph);
  }
  #tp-mobile-menu .tp-mm-sub.is-open { grid-template-rows: 1fr; }
  #tp-mobile-menu .tp-mm-sub__inner { overflow: hidden; min-height: 0; }
  #tp-mobile-menu .tp-mm-subitem {
    display: flex; align-items: baseline; gap: 14px;
    padding: 14px 0 14px 4px;
    font-size: 17px; font-weight: 400; line-height: 1.2;
    color: var(--on-surface-variant);
    border: none;
    opacity: 0; transform: translateX(-10px);
    transition: opacity 320ms var(--ease-standard), transform 320ms var(--ease-standard);
  }
  #tp-mobile-menu .tp-mm-subitem:first-child { padding-top: 20px; }
  #tp-mobile-menu .tp-mm-subitem:last-child { padding-bottom: 10px; }
  #tp-mobile-menu .tp-mm-sub.is-open .tp-mm-subitem {
    opacity: 1; transform: none;
    transition-delay: calc(var(--j) * 50ms + 70ms);
  }
  #tp-mobile-menu .tp-mm-subitem__num {
    font-weight: 600; font-size: 11px; letter-spacing: 0.16em; color: var(--primary);
  }

  /* staggered entry of the top-level items when the menu opens */
  @keyframes tpMmIn {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: none; }
  }
  #tp-mobile-menu.is-open > .tp-mm-item,
  #tp-mobile-menu.is-open > .tp-mm-group,
  #tp-mobile-menu.is-open > .tp-mobile-menu__cta {
    animation: tpMmIn 460ms var(--ease-emph) both;
    animation-delay: calc(var(--i, 0) * 65ms + 90ms);
  }

  @media (prefers-reduced-motion: reduce) {
    #tp-mobile-menu.is-open > .tp-mm-item,
    #tp-mobile-menu.is-open > .tp-mm-group,
    #tp-mobile-menu.is-open > .tp-mobile-menu__cta { animation: none; }
    #tp-mobile-menu .tp-mm-sub,
    #tp-mobile-menu .tp-mm-subitem,
    #tp-mobile-menu .tp-mm-chev { transition: none; }
  }
</style>

<script>
  const nav = document.getElementById('tp-nav');
  const toggle = document.getElementById('tp-nav-toggle');
  const menu = document.getElementById('tp-mobile-menu');
  const especToggle = document.getElementById('tp-mm-espec');
  const especSub = document.getElementById('tp-mm-sub');
  const body = document.body;
  let open = false;
  let scrollPos = 0;

  function applyScrolled() {
    if (!nav) return;
    nav.classList.toggle('is-scrolled', window.scrollY > 80 || open);
  }

  function openMenu() {
    open = true;
    // lock the page in place (keeps the visual position; blocks background scroll)
    scrollPos = window.scrollY;
    body.style.position = 'fixed';
    body.style.top = `-${scrollPos}px`;
    body.style.left = '0';
    body.style.right = '0';
    body.style.width = '100%';
    menu?.classList.add('is-open');
    toggle?.setAttribute('aria-expanded', 'true');
    applyScrolled();
  }

  function closeMenu() {
    open = false;
    menu?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
    // collapse the accordion so it reopens fresh next time
    especSub?.classList.remove('is-open');
    especToggle?.setAttribute('aria-expanded', 'false');
    // unlock and restore the previous scroll position (no smooth jump)
    body.style.position = '';
    body.style.top = '';
    body.style.left = '';
    body.style.right = '';
    body.style.width = '';
    const html = document.documentElement;
    const prevBehavior = html.style.scrollBehavior;
    html.style.scrollBehavior = 'auto';
    window.scrollTo(0, scrollPos);
    html.style.scrollBehavior = prevBehavior;
    applyScrolled();
  }

  toggle?.addEventListener('click', () => (open ? closeMenu() : openMenu()));

  // Especialidades accordion
  especToggle?.addEventListener('click', () => {
    const nowOpen = especSub?.classList.toggle('is-open');
    especToggle.setAttribute('aria-expanded', String(!!nowOpen));
  });

  // any navigation link closes the menu (and restores scroll) before navigating
  menu?.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest('a');
    if (link) closeMenu();
  });

  window.addEventListener('scroll', applyScrolled, { passive: true });
  applyScrolled();
</script>
