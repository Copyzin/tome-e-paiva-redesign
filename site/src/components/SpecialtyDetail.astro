---
// Full row used on /especialidades for each practice area.
import type { Specialty } from '../data/specialties';
interface Props { spec: Specialty; }
const { spec } = Astro.props;
---
<article id={spec.id} class="tp-spec-row">
  <div class="tp-spec-row__num">{spec.num}</div>
  <div class="tp-spec-row__body">
    <h2>{spec.title}</h2>
    <p>{spec.long}</p>
    <ul class="tp-spec-row__list">
      {spec.bullets.map((b) => <li>{b}</li>)}
    </ul>
  </div>
  <aside class="tp-spec-row__aside">
    <div class="tp-spec-row__aside-eyebrow">{spec.aside.eyebrow}</div>
    <h4>{spec.aside.title}</h4>
    <p>{spec.aside.body}</p>
    <a class="tp-spec-card__cta" href="/#contato" style="margin-top: 8px">
      Falar com a equipe
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7" /></svg>
    </a>
  </aside>
</article>
