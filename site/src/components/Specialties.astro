---
// Preview grid on the landing page (5 cards). Card #3 is visually featured.
import { Icon } from 'astro-icon/components';
import { SPECIALTIES } from '../data/specialties';
---
<section id="especialidades-preview" class="tp-section">
  <div class="tp-container">
    <div class="tp-section__header">
      <div class="tp-section__eyebrow">Áreas de atuação</div>
      <h2 class="tp-section__title">Cinco frentes do Direito. Uma <em>conduta</em>.</h2>
      <p class="tp-section__lede">
        Equipe dedicada por área, com domínio técnico e leitura estratégica.
        Selecione uma especialidade para conhecer a atuação em detalhe.
      </p>
    </div>
    <div class="tp-specialty-grid">
      {SPECIALTIES.map((s, i) => (
        <a href={`/especialidades#${s.id}`} class={`tp-spec-card ${i === 2 ? 'tp-spec-card--featured' : ''}`}>
          <div class="tp-spec-card__num"><span>{s.num}</span></div>
          <Icon name={`lucide:${s.iconName}`} class="tp-spec-card__icon" width={32} height={32} aria-hidden="true" />
          <h3>{s.title}</h3>
          <p>{s.short}</p>
          <span class="tp-spec-card__cta">
            Ver atuação
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7" /></svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style is:global>
  /* astro-icon replaces the old runtime Lucide; match the design's gold, thin-stroke look */
  .tp-spec-card__icon { color: var(--primary); stroke-width: 1.25px; }
</style>
